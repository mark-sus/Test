# Токен бота, який видає @BotFather після /newbot
BOT_TOKEN=8833598837:AAGnstQpGBB9UOxknkbSV8uZI97o1muwwjg

# Публічна HTTPS-адреса, на якій буде доступний вебдодаток
# (для тесту можна підняти через ngrok: https://xxxxx.ngrok-free.app)
PUBLIC_URchat_is://your-domain.example.com

# Telegram chat_id адміністратора(ів), через кому.
# Дізнатись свій chat_id можна написавши /start боту @userinfobot
