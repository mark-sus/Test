# Токен бота, який видає @BotFather після /newbot
BOT_TOKEN=123456789:AAABBBCCCDDDEEEFFFGGGHHHIIIJJJKKK

# Публічна HTTPS-адреса, на якій буде доступний вебдодаток
# (для тесту можна підняти через ngrok: https://xxxxx.ngrok-free.app)
PUBLIC_URL=https://your-domain.example.com

# Telegram chat_id адміністратора(ів), через кому.
# Дізнатись свій chat_id можна написавши /start боту @userinfobot
ADMIN_IDS=111111111,222222222

# Порт, на якому підніметься express-сервер
PORT=3000

# Якщо true — сервер перевірятиме підпис initData від Telegram WebApp (рекомендовано для продакшна)
VERIFY_INIT_DATA=false
